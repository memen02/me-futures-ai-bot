<resources>
    <style name="AccountFieldLabel" parent="DashLabel">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/me_text</item><item name="android:textStyle">bold</item>
    </style>
    <style name="AccountInput">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/me_touch_target</item><item name="android:singleLine">true</item>
        <item name="android:inputType">textPassword|textNoSuggestions</item><item name="android:saveEnabled">false</item>
        <item name="android:importantForAutofill">no</item><item name="android:maxLength">512</item>
        <item name="android:textSize">15sp</item><item name="android:textColor">@color/me_text</item>
        <item name="android:textColorHint">@color/me_muted</item><item name="android:fontFamily">monospace</item>
    </style>
    <style name="AccountPrimary" parent="DeskAction">
        <item name="android:layout_marginTop">12dp</item><item name="android:backgroundTint">@color/me_accent</item>
        <item name="android:textColor">@color/me_background</item>
    </style>
    <style name="AccountSecondary" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">@color/me_accent</item>
    </style>
</resources>
