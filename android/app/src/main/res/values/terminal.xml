<resources>
    <style name="TerminalPanel" parent="DashPanel">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:padding">@dimen/me_panel_padding</item>
        <item name="android:background">@drawable/dashboard_panel</item>
    </style>
    <style name="TerminalTitle" parent="DashHeading">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/me_text</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="TerminalNote" parent="DashLabel">
        <item name="android:textColor">@color/me_muted</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="TerminalRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:baselineAligned">false</item>
    </style>
    <style name="TerminalColumn" parent="TerminalRow"/>
    <style name="TerminalLink" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/me_accent</item>
    </style>
    <style name="TerminalCompactRow" parent="TerminalRow"/>
    <style name="TerminalCompactColumn" parent="TerminalColumn"/>
</resources>
