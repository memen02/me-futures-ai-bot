<resources>
    <style name="DashboardTheme" parent="StartupBase">
        <item name="android:colorAccent">@color/me_accent</item>
    </style>
    <style name="DashPanel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/me_section_gap</item>
        <item name="android:padding">@dimen/me_panel_padding</item>
        <item name="android:background">@drawable/dashboard_panel</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="DashLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/me_muted</item>
    </style>
    <style name="DashHeading" parent="DashLabel">
        <item name="android:textColor">@color/me_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="DashPrice" parent="DashHeading">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">23sp</item>
        <item name="android:text">—</item>
    </style>
    <style name="MarketDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/me_section_gap</item>
        <item name="android:background">@color/me_border</item>
    </style>
    <style name="MarketColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
    <style name="MarketValue" parent="DashPrice">
        <item name="android:textSize">17sp</item>
    </style>
</resources>
