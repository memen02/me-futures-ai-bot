<resources>
    <style name="DeskTab">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item><item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item><item name="android:paddingTop">7dp</item><item name="android:paddingBottom">6dp</item><item name="android:drawablePadding">3dp</item>
        <item name="android:textSize">12sp</item><item name="android:focusable">true</item><item name="android:clickable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <style name="DeskTitle" parent="DashHeading"><item name="android:textSize">22sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textStyle">bold</item></style>
    <style name="DeskAction"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">@dimen/me_touch_target</item><item name="android:textAllCaps">false</item><item name="android:textColor">@color/me_accent</item><item name="android:backgroundTint">@color/me_surface</item></style>
</resources>