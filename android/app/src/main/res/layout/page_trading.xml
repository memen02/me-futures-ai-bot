<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/me_panel_padding">
        <TextView style="@style/DeskTitle" android:text="Trading" />
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:text="Posisi Paper" />
            <Button style="@style/AccountPrimary" android:id="@+id/manual_open" android:text="Buka posisi Paper" />
            <TextView android:id="@+id/paper_open" style="@style/TerminalNote" android:lineSpacingExtra="3dp" />
            <Button style="@style/AccountSecondary" android:id="@+id/manual_close" android:text="Tutup posisi Paper" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:text="Posisi bot di bursa" />
            <TextView style="@style/TerminalNote" android:id="@+id/exchange_position" android:text="" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:text="Hasil posisi tertutup" />
            <Spinner android:id="@+id/report_mode" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Akun laporan" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <Button style="@style/TerminalLink" android:id="@+id/previous_month" android:text="‹" android:contentDescription="Bulan sebelumnya" />
                <TextView style="@style/TerminalNote" android:id="@+id/report_month" android:text="" android:lineSpacingExtra="3dp" />
                <Button style="@style/TerminalLink" android:id="@+id/next_month" android:text="›" android:contentDescription="Bulan berikutnya" />
            </LinearLayout>
            <TextView style="@style/TerminalNote" android:id="@+id/report_totals" android:text="" android:lineSpacingExtra="3dp" />
            <TextView style="@style/TerminalNote" android:id="@+id/report_closed" android:text="" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:text="Dompet Paper · USDT virtual" />
            <TextView android:id="@+id/account_wallet" style="@style/TerminalNote" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:text="Jurnal Paper" />
            <TextView style="@style/TerminalNote" android:id="@+id/paper_journal" android:text="" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
