<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_falcon_mask" android:tint="@color/me_accent" android:importantForAccessibility="no"/>
            <TextView style="@style/DeskTitle" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_weight="1" android:text="ME Project"/>
            <TextView style="@style/DashLabel" android:id="@+id/desk_bot" android:gravity="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="14dp">
            <TextView style="@style/DeskTitle" android:layout_width="0dp" android:layout_weight="1" android:text="Watchlist"/>
            <Button android:id="@+id/home_market" style="@style/TerminalLink" android:text="Semua pasar ›"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/watch_filters" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/desk_watch_source" style="@style/TerminalNote" android:layout_width="0dp" android:layout_weight="1"/>
            <TextView android:id="@+id/watch_price_heading" style="@style/TerminalNote" android:text="Harga / 24j"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/desk_watch_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <View style="@style/MarketDivider"/>
        <LinearLayout style="@style/TerminalPanel">
            <TextView style="@style/TerminalTitle" android:text="Sebaran pasar · 24j"/>
            <LinearLayout android:id="@+id/breadth_bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginVertical="6dp">
                <View android:id="@+id/breadth_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/me_buy"/>
                <View android:id="@+id/breadth_flat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/me_muted"/>
                <View android:id="@+id/breadth_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@color/me_sell"/>
            </LinearLayout>
            <TextView style="@style/TerminalNote" android:id="@+id/desk_coverage"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
