<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:focusableInTouchMode="true">
        <TextView style="@style/DeskTitle" android:text="Akun Binance" />
        <LinearLayout style="@style/DashPanel" android:background="@drawable/dashboard_signal">
            <TextView style="@style/DashLabel" android:text="BINANCE FUTURES" android:letterSpacing="0.10" android:textColor="#FFB58F" />
            <TextView style="@style/DashHeading" android:text="USDⓈ-M · Mainnet" android:textSize="23sp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/account_connection" style="@style/DashLabel" android:text="Belum terhubung"
                android:textSize="15sp" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <LinearLayout android:id="@+id/account_form" style="@style/DashPanel" android:importantForAutofill="noExcludeDescendants">
            <TextView style="@style/DashHeading" android:text="Kredensial API" />
            <TextView style="@style/DashLabel" android:layout_marginTop="4dp" android:text="Gunakan pasangan key HMAC dari API Management Binance." />
            <TextView style="@style/AccountFieldLabel" android:text="API Key" android:labelFor="@+id/account_key" />
            <EditText android:id="@id/account_key" style="@style/AccountInput" android:hint="Masukkan API Key"
                android:imeOptions="actionNext" />
            <TextView style="@style/AccountFieldLabel" android:text="API Secret" android:labelFor="@+id/account_secret" />
            <EditText android:id="@id/account_secret" style="@style/AccountInput" android:hint="Masukkan API Secret"
                android:imeOptions="actionDone" />
            <TextView style="@style/DashLabel" android:layout_marginTop="8dp"
                android:text="Tersimpan terenkripsi di HP. Jika secret lama hilang, buat pasangan API baru di Binance." />
            <Button android:id="@+id/account_save" style="@style/AccountPrimary" android:text="Simpan di HP" />
            <Button android:id="@+id/account_cancel" style="@style/AccountSecondary" android:text="Batal mengganti" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/account_actions" style="@style/DashPanel" android:visibility="gone">
            <TextView style="@style/DashHeading" android:text="Akses API" />
            <TextView android:id="@+id/account_access" style="@style/DashLabel" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" />
            <Button android:id="@+id/account_check" style="@style/AccountPrimary" android:text="Uji koneksi ke Binance" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/account_replace" style="@style/AccountSecondary" android:layout_width="0dp" android:layout_weight="1" android:text="Ganti key" />
                <Button android:id="@+id/account_remove" style="@style/AccountSecondary" android:layout_width="0dp" android:layout_weight="1" android:textColor="#FFA392" android:text="Hapus dari HP" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:id="@+id/execution_heading" android:text="Binance Futures Demo · BTC/USDT"/>
            <TextView style="@style/DashLabel" android:id="@+id/execution_help" android:text="Gunakan akun Demo khusus dengan mode One-way. Sinyal SMA 1m/5m, stop dan target dipasang di bursa demo. Menonaktifkan demo menutup sisa posisi ketika terhubung."/>
            <Button android:id="@+id/demo_keys" style="@style/AccountSecondary" android:text="Kelola key Demo"/>
            <Switch android:id="@+id/demo_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Jalankan dengan saldo Demo" android:textColor="#F7F1E9"/>
            <TextView android:id="@+id/demo_status" style="@style/DashLabel"/>
        </LinearLayout>
        <TextView style="@style/DashLabel" android:layout_marginTop="12dp" android:id="@+id/execution_note" android:text="Trading otomatis pada build ini memakai saldo simulasi. Uji koneksi hanya membaca status akun dan izin key." />
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:text="Perangkat" />
            <Switch android:id="@+id/account_autostart" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:text="Auto Start setelah reboot" android:textColor="#F7F1E9"/>
            <TextView style="@style/AccountFieldLabel" android:text="Pembersihan cache" />
            <TextView android:id="@+id/account_cache_status" style="@style/DashLabel" android:layout_marginBottom="12dp" />
            <TextView android:id="@+id/account_build" style="@style/DashLabel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
