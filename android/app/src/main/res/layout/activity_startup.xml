<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true"
    android:background="@drawable/startup_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="28dp" android:paddingEnd="28dp"
        android:paddingTop="24dp" android:paddingBottom="20dp">
        <ImageView android:layout_width="152dp" android:layout_height="152dp"
            android:layout_gravity="center_horizontal" android:src="@drawable/falcon_emblem"
            android:importantForAccessibility="no" android:scaleType="fitCenter" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:text="@string/app_name"
            android:textAllCaps="true" android:textColor="#FFF3E7" android:fontFamily="sans-serif-condensed"
            android:textStyle="bold|italic" android:textSize="36sp" android:letterSpacing="0.08" />
        <TextView android:id="@+id/startup_summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="30dp"
            android:textColor="#FFF3E7" android:textSize="18sp" android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/startup_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp"
            android:indeterminate="false" android:progressTint="#FF6329" android:progressBackgroundTint="#343841"
            android:max="3" />
        <LinearLayout android:id="@+id/startup_rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical">
            <Button android:id="@+id/startup_retry" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="Coba lagi"
                android:textAllCaps="false" android:textColor="#140D08" android:backgroundTint="#FF783E"
                android:visibility="gone" />
            <Button android:id="@+id/startup_open" style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="Buka dasbor" android:textAllCaps="false" android:textColor="#E1D5CB" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
