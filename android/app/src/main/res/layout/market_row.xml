<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:minHeight="@dimen/me_touch_target" android:gravity="center_vertical" android:paddingVertical="4dp" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_symbol" style="@style/DashHeading" android:textSize="16sp"/>
        <TextView android:id="@+id/row_model" style="@style/DashLabel"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/row_price" style="@style/DashHeading" android:textSize="16sp"/>
        <TextView android:id="@+id/row_change" style="@style/DashLabel"/>
    </LinearLayout>
</LinearLayout>
