<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView style="@style/DeskTitle" android:text="Simulasi otomatis"/>
        <LinearLayout style="@style/DashPanel">
            <TextView style="@style/DashHeading" android:text="Dompet simulasi"/>
            <TextView android:id="@+id/account_wallet" style="@style/DashLabel" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout style="@style/DashPanel"><TextView style="@style/DashHeading" android:text="Strategi model lokal"/><TextView android:id="@+id/paper_model" style="@style/DashLabel" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:textSize="15sp"/><Switch android:id="@+id/paper_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="Aktifkan transaksi virtual" android:textColor="#F7F1E9"/></LinearLayout><LinearLayout style="@style/DashPanel"><TextView style="@style/DashHeading" android:text="Posisi simulasi"/><TextView android:id="@+id/paper_open" style="@style/DashLabel" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:textSize="15sp"/></LinearLayout><LinearLayout style="@style/DashPanel"><TextView style="@style/DashHeading" android:text="Jurnal transaksi"/><TextView android:id="@+id/paper_journal" style="@style/DashLabel" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:textSize="15sp"/></LinearLayout>
    </LinearLayout>
</ScrollView>