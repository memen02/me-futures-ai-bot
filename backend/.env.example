# ME FUTURES AI BOT - contoh konfigurasi
# Salin file ini menjadi .env (cp .env.example .env) lalu isi sesuai kebutuhan Anda.
# JANGAN PERNAH mengisi API Key/Secret asli di sini, dan JANGAN commit file .env ke git.
# Lihat docs/SECURITY.md untuk aturan lengkap penyimpanan kredensial.

# --- Umum ---
NODE_ENV=development
LOG_LEVEL=info
# auto = deteksi otomatis berdasarkan RAM tersedia (lihat Fase 8 - ME SMART RESOURCE MANAGER)
LOW_RAM_MODE=auto

# --- Mode Bot ---
# paper   = simulasi lokal, TIDAK ada order ke Binance sama sekali (default, paling aman)
# testnet = order sungguhan tapi ke Binance Futures Testnet (uang palsu)
# live    = TERKUNCI di build ini sampai checklist Fase 12 lulus (lihat docs/TEST_PLAN.md)
BOT_MODE=paper

# --- Binance Futures ---
# Untuk pengembangan/testnet LOKAL boleh diisi di sini.
# Untuk PRODUKSI, API Key/Secret harus dimasukkan lewat APK Android dan disimpan
# terenkripsi di perangkat (bukan lewat file .env ini) - lihat docs/SECURITY.md.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Local API Server (dipakai APK Android, localhost-only) ---
APP_PORT=8787
# Token akan digenerate otomatis saat pertama kali start jika dikosongkan (Fase 10).
APP_LOCAL_AUTH_TOKEN=
